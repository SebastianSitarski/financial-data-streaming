                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test(\"error code CRYPTO_SYMBOL_NOT_FOUND\", () => pm.expect(body.code).to.eql(\"CRYPTO_SYMBOL_NOT_FOUND\"));",
                  "pm.test(\"message present\", () => pm.expect(body.message).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"message names the symbol\", () => pm.expect(body.message).to.include(\"BTCXYZ\"));"
