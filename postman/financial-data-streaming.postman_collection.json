{
  "info": {
    "_postman_id": "1d075303-9728-51d7-a0e3-8daeaad0fab3",
    "name": "financial-data-streaming",
    "description": "Binance public market-data REST integration exposed by the application.\n\nVariables: `baseUrl` (default http://localhost:8080), `symbol` (default BTCUSDT).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "symbol",
      "value": "BTCUSDT"
    }
  ],
  "item": [
    {
      "name": "Market data",
      "item": [
        {
          "name": "Current price",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/crypto/{{symbol}}/price",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crypto",
                "{{symbol}}",
                "price"
              ]
            },
            "description": "Binance: GET /api/v3/ticker/price"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"symbol matches\", () => pm.expect(body.symbol).to.eql(pm.variables.get(\"symbol\").toUpperCase()));",
                  "pm.test(\"price is a positive number\", () => pm.expect(body.price).to.be.a(\"number\").above(0));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Market information",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/crypto/{{symbol}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crypto",
                "{{symbol}}"
              ]
            },
            "description": "Combines Binance exchangeInfo and ticker/price"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has base and quote asset\", () => { pm.expect(body.baseAsset).to.be.a(\"string\"); pm.expect(body.quoteAsset).to.be.a(\"string\"); });",
                  "pm.test(\"has status\", () => pm.expect(body.status).to.be.a(\"string\"));",
                  "pm.test(\"price is a positive number\", () => pm.expect(body.price).to.be.a(\"number\").above(0));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "24h statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/crypto/{{symbol}}/stats",
