                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crypto",
                "{{symbol}}",
                "stats"
              ]
            },
            "description": "Binance: GET /api/v3/ticker/24hr"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has all stats fields\", () => pm.expect(body).to.have.all.keys(\"symbol\",\"lastPrice\",\"priceChange\",\"priceChangePercent\",\"highPrice\",\"lowPrice\",\"volume\"));",
                  "pm.test(\"high >= low\", () => pm.expect(body.highPrice).to.be.at.least(body.lowPrice));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Candles (1h, limit 100)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/crypto/{{symbol}}/candles?interval=1h&limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crypto",
                "{{symbol}}",
                "candles"
              ],
              "query": [
                {
                  "key": "interval",
                  "value": "1h"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "Binance: GET /api/v3/klines"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns 100 candles\", () => pm.expect(body).to.be.an(\"array\").with.lengthOf(100));",
                  "pm.test(\"candle has OHLCV fields\", () => pm.expect(body[0]).to.have.all.keys(\"openTime\",\"open\",\"high\",\"low\",\"close\",\"volume\"));",
                  "pm.test(\"openTime is ISO-8601\", () => pm.expect(new Date(body[0].openTime).toISOString()).to.eql(body[0].openTime));"
                ]
              }
            }
          ],
          "response": []
        },
